{
  "name": "homestyle-api",
  "version": "1.0.0",
  "description": "API сервер для интернет-магазина HomeStyle с PostgreSQL",
  "main": "server/api.js",
  "scripts": {
    "start": "node server/api.js",
    "dev": "nodemon server/api.js",
    "test": "jest",
    "db:migrate": "psql -d homestyle -f database/schema.sql",
    "db:seed": "node database/seed.js"
  },
  "keywords": [
    "ecommerce",
    "api",
    "postgresql",
    "express",
    "homestyle"
  ],
  "author": "HomeStyle Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

# Переменные окружения для HomeStyle API

# База данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=homestyle
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Настройки сервера
PORT=3000
NODE_ENV=development

# JWT Secret (замените на случайную строку в продакшене!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS настройки (разрешенные домены)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500

# Настройки безопасности
BCRYPT_ROUNDS=10
SESSION_TIMEOUT=604800

# Email настройки (для уведомлений)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# Платежная система (пример для Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# Файловая система
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Лимиты API
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
